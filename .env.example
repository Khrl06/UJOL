# =====================================================================
# SmartExam AI (UJOL) - Template Konfigurasi Environment (.env.example)
# Salin file ini menjadi .env lalu sesuaikan nilainya dengan konfigurasi lokal.
# =====================================================================

# Informasi Aplikasi
APP_NAME="SmartExam AI"
APP_ENV=development
APP_URL=http://localhost/UJOL/public
SCHOOL_NAME="SMA Negeri 1 Unggulan"

# Konfigurasi Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartexam_db
DB_USERNAME=root
DB_PASSWORD=

# Konfigurasi WhatsApp Gateway (OTP & Notifikasi)
WA_API_TOKEN=your_whatsapp_gateway_token_here

# Konfigurasi AI Provider & Model (Universal Multi-Provider)
AI_PROVIDER=custom
AI_MODEL_NAME=UMAM
AI_BASE_URL=https://your-custom-ai-provider.com/v1
AI_API_KEY=your_secret_api_key_here

# Background Service Chatbot (Node.js Port 3001)
CHATBOT_SERVER_URL=http://localhost:3001
